    {
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "type": "stat",
      "title": "KV Cache Usage (avg) \u2014 N/A for NemotronH",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "avg(dynamo_component_gpu_cache_usage_percent{pod=~\"$pod_regex\"})",
          "legendFormat": "avg"
