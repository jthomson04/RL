      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(dynamo_component_inflight_requests{pod=~\"$pod_regex\",dynamo_endpoint=\"generate\"})",
          "legendFormat": "total"
