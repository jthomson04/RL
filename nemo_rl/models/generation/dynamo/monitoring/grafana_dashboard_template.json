      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(vllm:prefix_cache_hits_total{pod=~\"$pod_regex\"}[5m])) / sum(rate(vllm:prefix_cache_queries_total{pod=~\"$pod_regex\"}[5m]))",
          "legendFormat": "prefix-cache hit ratio"
