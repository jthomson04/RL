      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(dynamo_frontend_model_max_num_seqs{pod=~\"$pod_regex\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 205,
