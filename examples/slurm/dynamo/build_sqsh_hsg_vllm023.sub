#!/usr/bin/env bash
#SBATCH --account=coreai_tritoninference_triton3
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=160G
#SBATCH --time=06:00:00
#SBATCH --job-name=nemo-rl-vllm023-swe-image

set -euo pipefail

ROOT=${ROOT:-/lustre/fsw/portfolios/coreai/users/jothomson/nemo-rl-dynamo-slurm-swe}
REPO=${REPO:-${ROOT}/RL}
BASE_IMAGE=${BASE_IMAGE:-${ROOT}/images/nemo-rl-dynamo-swe-hsg.sqsh}
OUTPUT=${OUTPUT:-${ROOT}/images/nemo-rl-dynamo-swe-hsg-vllm023.sqsh}

export ENROOT_CACHE_PATH=${ENROOT_CACHE_PATH:-${ROOT}/cache/enroot}
export ENROOT_DATA_PATH=${ENROOT_DATA_PATH:-${ROOT}/cache/enroot-data}
export ENROOT_RUNTIME_PATH=${ENROOT_RUNTIME_PATH:-${ROOT}/cache/enroot-runtime}
export ENROOT_TEMP_PATH=${ENROOT_TEMP_PATH:-${ROOT}/cache/enroot-tmp}
mkdir -p \
  "${ROOT}/images" \
  "${ROOT}/logs" \
  "${ENROOT_CACHE_PATH}" \
  "${ENROOT_DATA_PATH}" \
  "${ENROOT_RUNTIME_PATH}" \
  "${ENROOT_TEMP_PATH}"

test -s "${BASE_IMAGE}"
test "$(uname -m)" = aarch64
if [[ -e "${OUTPUT}" ]]; then
  echo "Refusing to overwrite existing image: ${OUTPUT}" >&2
  exit 1
fi

export ROOT REPO
srun \
  --container-image="${BASE_IMAGE}" \
  --container-remap-root \
  --container-writable \
  --no-container-mount-home \
  --container-save="${OUTPUT}" \
  --container-mounts="/lustre:/lustre" \
  --container-workdir="${REPO}" \
  /bin/bash examples/swe_bench/assemble_nano_v3_5_swe_vllm_hsg_image.sh

test -s "${OUTPUT}"
ls -lh "${OUTPUT}"
